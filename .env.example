# Copy this file to .env and adjust values before running `docker compose up`.

# Postgres credentials (used by the db container and by the backend)
POSTGRES_USER=baby
POSTGRES_PASSWORD=baby
POSTGRES_DB=baby

# Secret used to sign JWT auth tokens. Set a long random string in production.
JWT_SECRET=change-me-in-production

# Registration code. Anyone registering must supply this so only you and
# your wife can create accounts. Share it privately.
INVITE_CODE=bumblebee
